# CodeViz backend — environment. Copy to `.env` and fill in.
# In production the server refuses to start unless JWT_SECRET, MONGO_URI and
# FRONTEND_URL are set (see the config guard in server.js).

# ---- Core ----
NODE_ENV=production
PORT=5001
# 127.0.0.1 for a host deploy behind nginx; 0.0.0.0 if the backend runs in a container.
BIND_HOST=127.0.0.1
# Long random string (>= 24 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Public URL of the frontend — used for CORS and password-reset links.
FRONTEND_URL=https://yourdomain.com

# ---- Database (MongoDB Atlas in production) ----
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/codeviz

# ---- Certificates (falls back to JWT_SECRET if unset) ----
CERT_SECRET=

# ---- AI providers (at least one; the orchestrator falls back across them) ----
GEMINI_API_KEY=
GROQ_API_KEY=
# Local model for bulk content generation (optional, no quota):
# COURSE_GEN_PROVIDER=ollama

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids from your Razorpay dashboard (optional until you sell):
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_TEAM_PLAN_ID=

# ---- Email / SMTP (password reset, notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CodeViz <no-reply@yourdomain.com>

# ---- Redis (optional; caching/rate-limit — graceful if absent) ----
REDIS_URL=

# ---- Observability (optional; no-op if unset) ----
SENTRY_DSN=

# ---- Code-execution sandbox tuning ----
EXEC_MAX_CONCURRENT=4
EXEC_MAX_QUEUE=50
EXEC_CPUS=1
# Absolute host path for sandbox run dirs. REQUIRED if the backend runs in a
# container (bind-mount the same host path at the same path). Leave unset on a host deploy.
# EXEC_DIR=/opt/codeviz/runs
