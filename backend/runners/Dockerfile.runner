# CodeViz Secure Code Runner
# A minimal, hardened image for executing user-submitted code in multiple languages.

FROM alpine:3.19

# Install runtime dependencies + debuggers/toolchains for real tracing
RUN apk add --no-cache \
    python3 \
    nodejs \
    npm \
    g++ \
    gcc \
    openjdk17 \
    gdb \
    go \
    rust \
    cargo \
    musl-dev \
    bash

# Install JavaScript tracer dependencies globally
RUN npm install -g acorn astring

# Set NODE_PATH to ensure global modules are found without a local node_modules
ENV NODE_PATH=/usr/local/lib/node_modules

# Bake CodeViz native-language tracers into the image (compiled once, reused per run)
COPY backend/engine/gdbTracer.py /opt/codeviz/gdbTracer.py
COPY backend/engine/JdiTracer.java /opt/codeviz/JdiTracer.java
RUN javac --add-modules jdk.jdi -d /opt/codeviz /opt/codeviz/JdiTracer.java \
    && chmod -R a+rX /opt/codeviz

# Go: use a writable cache/module dir inside the sandbox
ENV GOCACHE=/tmp/gocache
ENV GOPATH=/tmp/gopath
ENV GOFLAGS=-mod=mod

# Create a non-privileged user
RUN addgroup -S runner && adduser -S runner -G runner

# Set up working directory
WORKDIR /home/runner/code

# Ensure the runner user owns the directory
RUN chown -R runner:runner /home/runner/code

USER runner

# Use a generic entrance or just wait for command
CMD ["bash"]
