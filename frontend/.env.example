# CodeViz frontend — build-time env (Vite). Copy to `.env` or pass at build.

# Backend API base URL. Local default is http://localhost:5001 if unset.
# In production set to your public URL (nginx proxies /api to the backend).
VITE_API_URL=https://yourdomain.com

# ---- Observability (optional; no-op if unset) ----
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
